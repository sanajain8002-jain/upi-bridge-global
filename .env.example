# Copy to .env (never commit .env). No real secrets belong in this file.
PORT=3000
# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`). Signs session tokens.
SESSION_SECRET=change-me-to-a-long-random-string
# SQLite file location (use a persistent disk in production).
DATABASE_PATH=./data/upi-bridge.db
# Seed SAMPLE demo users + transactions on first start.
SEED_DEMO_DATA=true
# Enables the "Demo user / Demo admin" buttons for judges. Set false on any public deployment.
DEMO_MODE=true
# Optional: indicative-rate provider returning JSON { "rates": { "NPR": 1.6, ... } } per 1 INR
# (e.g. a free exchange-rate API with base=INR). Leave empty to keep clearly-labelled SAMPLE rates.
EXCHANGE_RATE_API_URL=
